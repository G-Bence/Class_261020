<Window x:Class="Class_261020.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Class_261020"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Background="#FF141414">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,5">
            <StackPanel>
                <TextBlock Text="Almost Netflix" FontSize="32" FontWeight="SemiBold" Foreground="#FFE50914"/>
                <TextBlock x:Name="fileNameText" Text="Choose a movie or a series."
                       Foreground="#FFB20710" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Search by title" Margin="0,0,0,5" Foreground="#FFE2E2E2"/>
                <TextBox x:Name="searchTextBox" Padding="6"/>
            </StackPanel>
            <Button x:Name="filterButton" Grid.Column="1" Content="Filter"
                Padding="14,6" Margin="10,0,0,0" VerticalAlignment="Bottom"
                Click="filterButton_Click"/>
            <Button x:Name="showAllButton" Grid.Column="2" Content="Show all"
                Padding="14,6" Margin="10,0,0,0" VerticalAlignment="Bottom"
                Click="showAllButton_Click"/>
            <Button x:Name="longestButton" Grid.Column="3" Content="Select longest"
                Padding="14,6" Margin="10,0,0,0" VerticalAlignment="Bottom"
                Click="longestButton_Click"/>
        </Grid>

        <ListView x:Name="contentListView" Grid.Row="2" SelectionMode="Single"
              SelectionChanged="contentListView_SelectionChanged" Foreground="#FF111111">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Title" Width="480" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="Type" Width="110" DisplayMemberBinding="{Binding ContentType}"/>
                    <GridViewColumn Header="Length (min)" Width="120" DisplayMemberBinding="{Binding Length}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="3" Margin="0,15,0,0">
            <TextBlock x:Name="contentCountText" Foreground="#FFB20710"/>
            <TextBlock x:Name="selectedContentText" Text="Select a movie"
                   FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" Foreground="#FFE2E2E2"/>
        </StackPanel>
    </Grid>
</Window>
